def main():
    {% for env in envs %}
    {{ env.name|lower }} = {{ env.name }}("{{ env.name }}")
    {% endfor %}

    agent_list = []
    {% for agent in agents %}
    {% if agent.instance_count > 1 %}
    for i in range({{ agent.instance_count }}):
        agent_list.append({{ agent.name }}())
    {% else %}
    agent_list.append({{ agent.name }}())
    {% endif %}
    {% endfor %}

    {% set ns = namespace(channels=[]) %}
    {% for agent in agents %}
    {% if agent.channel and agent.channel not in ns.channels %}
    {% set ns.channels = ns.channels + [agent.channel] %}
    {% endif %}
    {% endfor %}
    {% for ch in ns.channels %}
    {{ ch|lower }}_ch = Channel("{{ ch }}")
    {% endfor %}

    connections = []
    {% for env in envs %}
    connections.append({{ env.name|lower }})
    {% endfor %}
    {% for ch in ns.channels %}
    connections.append({{ ch|lower }}_ch)
    {% endfor %}
    if connections:
        Admin().connect_to(agent_list, connections)

    Admin().start_system()

if __name__ == "__main__":
    main()