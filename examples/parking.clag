agent Driver
beliefs: Budget
desires: CheckPrice
plans:
    CheckPrice(
        when: achieve CheckPrice 
        contains: believe Budget, achieve Parking)
    do
        achieve OfferMade
    end
    NoSpots(
        when: achieve NoSpotsAvailable )
    do
        disbelieve Parking
    end

environment Parking
perceptions: SoldSpots
actions:
    ParkSpot do
        percept Spot
    end
    LeaveSpot do
        change Spot
    end