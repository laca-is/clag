agent CoffeeMachine
desires: MakeBlackCoffee 
beliefs: HasCoffeeBeans
plans: 
    ExpressoReady(
        when: achieve MakeExpressoCoffee 
        contains: believe HasCoffeeBeans
        )
    do
        achieve MakeCoffee,
        abandon MakeExpressoCoffee
    end

    BlackReady(
        when: achieve MakeBlackCoffee 
        contains: believe HasCoffeeBeans, believe HasFilter)
    do
        achieve MakeCoffee,
        disbelieve HasFilter
    end

    BuyCoffeeBeans(
        when: disbelieve HasCoffeeBeans)
    do
        believe HasCoffeeBeans
    end

    MakeCoffee(when: achieve MakeCoffee) do
        disbelieve HasCoffeeBeans
    end

environment CoffeeShop
perceptions: HasCoffee
actions: BuyCoffeeBeans