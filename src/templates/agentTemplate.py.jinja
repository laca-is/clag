{% for agent in agents %}
class {{ agent.name }}Agent(Agent):
    def __init__(self, name=None):
        super().__init__(name)
        {% for belief in agent.beliefs %}
        self.add(Belief('{{ belief }}'))
        {% endfor %}
        {% for desire in agent.desires %}
        self.add(Goal('{{ desire }}'))
        {% endfor %}

    {% for plan in agent.plans %}
    @pl({{ plan.when.split()[0]|changeStr(True) }}, {{ plan.when.split()[1]|contextType(plan.when.split()[0]) }}{% if plan.conditions %}{{ plan.conditions|conditionsStr() }}{% endif %})
    def {{ plan.name }}(self, src):
        {% for action in plan.actions %}
        self.{{ action.split()[0]|changeStr(False) }}({{ action.split()[1]|contextType(action.split()[0]) }})
        {% else %}
        pass
        {% endfor %}
        
    {% endfor %}
    
{% endfor %}