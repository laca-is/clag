Agent:
    'agent' name=ID 
    ( ('beliefs:' beliefs*=ID[','])?
    ('desires:' desires*=ID[','])?
    ('plans:' plans*=Plans)? )#
;

Plans:
    name=ID '(' 
    'when:' data=Action 
    ('contains:' conditions*=Condition[','])? ')' 
    'do' actions*=Action[','] 'end'
;

Condition:
    ctxType=ActionType name=ID
;

Action:
    actType=ActionType name=ID
;

ActionType:
    'believe' | 'disbelieve' | 'achieve' | 'abandon'
;
